{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "jsx": "preserve"
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "tests/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
